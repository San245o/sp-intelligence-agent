# Optional private provider configuration. No real keys belong in this file.
# Set process environment variables; copying this file alone does not load it.
SERPER_API_KEY=
SERPER_API_KEY_2=
SERPER_API_KEY_3=
TAVILY_API_KEY=
# Optional ignored local configuration may hold keys for this workstation only.
SIGNALPOST_USE_LOCAL_DEFAULTS=1
# Actual USD per provider credit; leave unset to report unknown monetary cost.
SERPER_USD_PER_CREDIT=
