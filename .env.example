# ==============================================================================
# Signalpost Search Provider Configuration (All Optional)
# By default, the agent runs at $0.00 spend on pure Brreg + DNS probing.
# Any keys provided below will be used as chained fallbacks in priority order.
# Multiple comma-separated keys are supported for rotation (e.g. KEY=k1,k2).
# ==============================================================================

# 1. Serper.dev (Google Search) - Recommended Primary
# Free tier: 2,500 one-time queries on signup, no credit card required.
# Signup: https://serper.dev
SERPER_API_KEY=b77d0c864c5341dc692188db224a635d94d9b0b8

# 2. Google Custom Search JSON API
# Free tier: 100 queries per day, no credit card required.
# Setup: https://programmablesearchengine.google.com/
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# 3. Tavily Search API
# Free tier: 1,000 queries per month, no credit card required.
# Signup: https://tavily.com
TAVILY_API_KEY=

# 4. Brave Search API
# Free tier: 2,000 queries per month, no credit card required.
# Signup: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# 5. Bing Web Search API v7 (Azure F0 Tier)
# Free tier: 1,000 queries per month on Azure Cognitive Services.
BING_SEARCH_API_KEY=

# 6. Exa.ai Search API
# Free tier: $10 trial credit (~1,000 queries) on signup.
# Signup: https://exa.ai
EXA_API_KEY=
